{
  "name": "renkflow-web-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "if [ -f .next/standalone/server.js ]; then node -r dotenv/config .next/standalone/server.js dotenv_config_path=.env.local; elif [ -f .next/standalone/apps/web/server.js ]; then node -r dotenv/config .next/standalone/apps/web/server.js dotenv_config_path=.env.local; else next start; fi",
    "lint": "eslint .",
    "db:push": "node scripts/push-schema.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:ensure-backend": "tsx scripts/ensure-backend-schema.ts",
    "db:check-manufacturing": "tsx scripts/check-manufacturing-schema.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "pilot:manufacturing": "tsx --require ./scripts/register-server-only.cjs scripts/pilot-native-manufacturing.ts",
    "ws:server": "tsx server/index.ts",
    "type-check": "tsc --noEmit",
    "type-check:manufacturing": "tsc --noEmit -p tsconfig.manufacturing.json",
    "test": "jest",
    "test:manufacturing": "jest --config jest.manufacturing.config.js --runInBand",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "load:seed": "tsx scripts/load/seed-load.ts",
    "load:run": "node scripts/load/run-load.mjs",
    "test:e2e": "playwright test",
    "start:standalone": "if [ -f .next/standalone/server.js ]; then node -r dotenv/config .next/standalone/server.js dotenv_config_path=.env.local; elif [ -f .next/standalone/apps/web/server.js ]; then node -r dotenv/config .next/standalone/apps/web/server.js dotenv_config_path=.env.local; else echo 'Standalone server output not found. Run npm run build first.' && exit 1; fi",
    "start:next": "next start",
    "guard:tenant-scope": "bash scripts/guardrails/tenant-scope.sh",
    "guard:tenant-scope-sql": "tsx scripts/guardrails/tenant-scope-sql.ts",
    "env:audit": "tsx scripts/guardrails/env-contract-audit.ts",
    "validate": "npm run guard:backends && npm run guard:tenant-scope && npm run guard:tenant-scope-sql && npm run env:audit && npm run type-check && npm run lint && npm test -- --runInBand && npm run build",
    "smoke:live": "bash scripts/smoke-live.sh",
    "smoke:coming-soon": "bash scripts/smoke-coming-soon.sh",
    "db:local": "tsx scripts/dev-database.ts",
    "worker:production": "tsx --require ./scripts/register-server-only.cjs scripts/production-worker.ts",
    "test:production": "tsx --require ./scripts/register-server-only.cjs scripts/test-production-platform.ts",
    "test:ai": "tsx --require ./scripts/register-server-only.cjs scripts/test-ai-suggestions.ts",
    "evals": "tsx --require ./scripts/register-server-only.cjs evals/run.ts",
    "evals:assistant": "tsx --require ./scripts/register-server-only.cjs evals/assistant.ts",
    "evals:export": "tsx --require ./scripts/register-server-only.cjs evals/export-feedback.ts",
    "test:production:browser": "node scripts/verify-production-browser.cjs",
    "smoke:ai": "tsx --require ./scripts/register-server-only.cjs scripts/smoke-ai-extraction.ts",
    "guard:backends": "tsx scripts/guardrails/vercel-backends.ts",
    "env:check": "tsx scripts/check-vercel-env.ts",
    "build:vercel": "node scripts/patch-dependencies.cjs && npm run env:check -- --deployment && npm run build",
    "postinstall": "node scripts/patch-dependencies.cjs",
    "db:deploy": "tsx scripts/deploy-database.ts",
    "db:status": "tsx scripts/db-status.ts",
    "db:restore-backup": "tsx scripts/restore-backup.ts",
    "vercel:env:sync": "tsx scripts/sync-vercel-env.ts",
    "test:warehouse": "tsx --require ./scripts/register-server-only.cjs scripts/test-warehouse.ts",
    "test:count-import": "tsx --require ./scripts/register-server-only.cjs scripts/test-count-import.ts",
    "test:stock-threshold": "tsx --require ./scripts/register-server-only.cjs scripts/test-stock-threshold.ts",
    "test:price-matrix": "tsx --require ./scripts/register-server-only.cjs scripts/test-price-matrix.ts",
    "test:family-recipes": "tsx --require ./scripts/register-server-only.cjs scripts/test-family-recipes.ts",
    "test:quote-configurator": "tsx --require ./scripts/register-server-only.cjs scripts/test-quote-configurator.ts",
    "test:records": "tsx --require ./scripts/register-server-only.cjs scripts/test-records.ts",
    "test:sales": "tsx --require ./scripts/register-server-only.cjs scripts/test-sales.ts",
    "test:production-depth": "tsx --require ./scripts/register-server-only.cjs scripts/test-production-depth.ts",
    "test:stock-depth": "tsx --require ./scripts/register-server-only.cjs scripts/test-stock-depth.ts",
    "test:access": "tsx --require ./scripts/register-server-only.cjs scripts/test-access.ts",
    "test:chain": "tsx --require ./scripts/register-server-only.cjs scripts/test-chain.ts",
    "test:fleet": "tsx --require ./scripts/register-server-only.cjs scripts/test-fleet.ts",
    "test:finance": "tsx --require ./scripts/register-server-only.cjs scripts/test-finance.ts",
    "test:ai-assistant": "tsx --require ./scripts/register-server-only.cjs scripts/test-ai-assistant.ts",
    "test:ai-commands": "tsx --require ./scripts/register-server-only.cjs scripts/test-ai-commands.ts",
    "test:ai-extras": "tsx --require ./scripts/register-server-only.cjs scripts/test-ai-extras.ts",
    "test:ai-extract": "tsx --require ./scripts/register-server-only.cjs scripts/test-ai-extract.ts",
    "test:warehouse:browser": "node scripts/verify-warehouse-browser.cjs",
    "test:field": "tsx --require ./scripts/register-server-only.cjs scripts/test-native-field.ts",
    "prebuild": "node scripts/sync-pdf-worker.cjs",
    "predev": "node scripts/sync-pdf-worker.cjs",
    "postbuild": "node scripts/verify-pdf-server-bundle.cjs"
  },
