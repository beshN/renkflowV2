{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci --workspaces=false --legacy-peer-deps",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": ".next",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/fx",
      "schedule": "45 13 * * 1-5"
    },
    {
      "path": "/api/cron/storage-cleanup",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/inbound",
      "schedule": "20 5 * * *"
    },
    {
      "path": "/api/cron/e-invoices",
      "schedule": "40 5 * * *"
    }
  ]
}
