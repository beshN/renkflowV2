# RenkFlow - Environment Variables (Cloud SQL + GCS + Cloud Run)

# Database (Cloud SQL socket style for production)
# Example:
# postgresql://USER:PASSWORD@localhost/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE&sslmode=disable
DATABASE_URL=""

# Storage (Google Cloud Storage only)
STORAGE_BACKEND="gcs"
GCS_BUCKET_NAME=""
GCS_PUBLIC_URL=""

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
PUBLIC_SITE_MODE="off" # off | coming-soon

# Auth.js secret management
AUTH_SECRET="" # preferred primary secret
NEXTAUTH_SECRET="" # keep equal to AUTH_SECRET
AUTH_TRUST_HOST="false"

# OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Email
RESEND_API_KEY=""
RESEND_INFO_EMAIL=""
RESEND_UPDATES_EMAIL=""
RESEND_SUPPORT_EMAIL=""

# Push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Analytics and observability
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_APP_VERSION="1.0.0"

# AI
AI_PROVIDER="gemini" # gemini | openai | claude
GEMINI_API_KEY=""
GOOGLE_API_KEY="" # optional alias for Gemini key
GEMINI_MODEL="gemini-2.5-flash"
