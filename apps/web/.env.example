# RenkFlow — local development template. No real secrets belong in Git.
# Vercel Production / Preview templates: .env.vercel.*.example
# Local: use .env.local (ignored); cloud values live in Vercel Project Settings.
DATABASE_URL=""
# Direct connection for migrations only. Runtime uses the pooled DATABASE_URL.
DATABASE_URL_UNPOOLED=""
STORAGE_BACKEND="local" # local for development; vercel-blob on Vercel
BLOB_READ_WRITE_TOKEN=""
# Optional server-side OIDC authentication; browser token issuance still needs the RW token.
BLOB_STORE_ID=""
DEPLOYMENT_ENVIRONMENT="development"
CRON_SECRET=""
ALLOW_LOCAL_STORAGE="0"

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
PUBLIC_SITE_MODE="off" # off | coming-soon
NODE_ENV="development"
NEXT_PHASE=""

# Auth.js secret management
AUTH_SECRET="" # preferred primary secret
NEXTAUTH_SECRET="" # keep equal to AUTH_SECRET
AUTH_TRUST_HOST="false"
AUTH_DEBUG="false"
INTERNAL_API_SECRET=""

# API security / CORS
API_CORS_ALLOW_ALL="false"
API_CORS_ALLOWED_ORIGIN=""

# OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Email
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESEND_INFO_EMAIL=""
RESEND_UPDATES_EMAIL=""
RESEND_SUPPORT_EMAIL=""

# Push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Analytics and observability
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_GOOGLE_VERIFICATION=""
NEXT_PUBLIC_SENTRY_DSN=""
AUDIT_LOG_SECRET=""
LOG_LEVEL="info"
ENABLE_CONSOLE_LOGS="false"
ENABLE_ADMIN_NOTIFICATIONS="false"
ADMIN_NOTIFICATION_EMAIL=""
ELASTICSEARCH_URL=""
ELASTICSEARCH_API_KEY=""

# AI (lib/ai/providers.ts). The product runs on Anthropic Claude Sonnet 5.5 (deployment contract);
# openai, gemini and glm are only for order-extraction evals and local trials.
# Never commit a real key: set ANTHROPIC_API_KEY in .env.local and as a sensitive Vercel variable.
AI_PROVIDER="anthropic" # anthropic | openai | gemini | glm
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6-luna"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_BASE_URL="" # default: https://generativelanguage.googleapis.com/v1beta/openai/
ZAI_API_KEY=""
ZAI_MODEL="glm-5.3-flash"
ZAI_BASE_URL="" # default: https://api.z.ai/api/paas/v4/ (mainland: https://open.bigmodel.cn/api/paas/v4/)
# Optional: USD per million tokens per model, for cost records in ai_usage. claude-sonnet-5-5 has a
# built-in list price (lib/ai/usage.ts); other models without a price are recorded without cost.
# AI_MODEL_PRICES_USD_PER_MTOK={"gpt-6-luna":{"input":0,"output":0}}
AI_MODEL_PRICES_USD_PER_MTOK=

# Optional realtime/public toggles
NEXT_PUBLIC_USE_DATABASE="true"
NEXT_PUBLIC_SOCKET_URL=""
NEXT_PUBLIC_WS_URL=""
NEXT_PUBLIC_SUPPORT_SOCKET_URL=""
NEXT_PUBLIC_SUPPORT_SOCKET_PATH="/socket.io"
WS_PORT="3001"

# Native inventory / manufacturing pilot (use a separate test database)
NATIVE_INVENTORY_ENABLED="0"
# Local production-build verification only: explicit localhost TCP port required
ALLOW_LOCAL_DATABASE="0"
PILOT_TENANT_ID=""
PILOT_USER_ID=""
PILOT_ORDER_ID=""


# Production notifications (worker:production) and signed inbound webhooks
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
EMAIL_INBOUND_TENANT_ID=
EMAIL_INBOUND_ADDRESS=
# Exact provider CDN hostnames returned by the receiving API, comma separated
INBOUND_ATTACHMENT_HOSTS=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=tr
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_INBOUND_TENANT_ID=

# Local browser verification only; keep unset on Vercel
ALLOW_INSECURE_HTTP="0"
CHROME_EXECUTABLE=""

# Optional owner-only pilot: restrict sign-in and disable public registration.
PRIVATE_ACCESS_EMAIL=

# Local verification scripts only: set to 1 to let verify-assistant-browser call the real model
RUN_REAL_AI="0"

# Dedicated local mobile test fixtures (never a cloud database)
RENKFLOW_TEST_DB_PORT=55432

# e-Belge (e-Fatura / e-Arşiv). Empty: off, invoices keep internal FTR- numbers and are not sent.
# "mock" is for local runs and tests only and refuses to start in production.
E_INVOICE_PROVIDER=
# mock only: comma-separated tax numbers the stand-in treats as registered e-Fatura users
E_INVOICE_MOCK_REGISTERED=
# mock only: allow it under `next start` on a developer machine (never set on Vercel)
E_INVOICE_ALLOW_MOCK=
