# RenkFlow - Environment Variables (Cloud SQL + GCS + Cloud Run)

# Database (Cloud SQL socket style for production)
# Example:
# postgresql://USER:PASSWORD@localhost/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE&sslmode=disable
DATABASE_URL=""
# Temporary migration escape hatch. Keep disabled unless an approved legacy
# PostgreSQL host must remain available while Cloud SQL is being provisioned.
ALLOW_LEGACY_DATABASE_HOSTS="0"

# Storage (Google Cloud Storage only)
STORAGE_BACKEND="gcs"
GCS_BUCKET_NAME=""
GCS_PUBLIC_URL=""

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
PUBLIC_SITE_MODE="off" # off | coming-soon
NODE_ENV="development"
NEXT_PHASE=""

# Auth.js secret management
AUTH_SECRET="" # preferred primary secret
NEXTAUTH_SECRET="" # keep equal to AUTH_SECRET
AUTH_TRUST_HOST="false"
AUTH_DEBUG="false"
INTERNAL_API_SECRET=""

# API security / CORS
API_CORS_ALLOW_ALL="false"
API_CORS_ALLOWED_ORIGIN=""

# OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Email
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESEND_INFO_EMAIL=""
RESEND_UPDATES_EMAIL=""
RESEND_SUPPORT_EMAIL=""

# Push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Analytics and observability
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_GOOGLE_VERIFICATION=""
NEXT_PUBLIC_SENTRY_DSN=""
AUDIT_LOG_SECRET=""
LOG_LEVEL="info"
ENABLE_CONSOLE_LOGS="false"
ENABLE_ADMIN_NOTIFICATIONS="false"
ADMIN_NOTIFICATION_EMAIL=""
ELASTICSEARCH_URL=""
ELASTICSEARCH_API_KEY=""

# AI
AI_PROVIDER="gemini" # gemini | openai | claude
AI_MODEL=""
GEMINI_API_KEY=""
GOOGLE_API_KEY="" # optional alias for Gemini key
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-3-5-sonnet-latest"

# Optional realtime/public toggles
NEXT_PUBLIC_USE_DATABASE="true"
NEXT_PUBLIC_SOCKET_URL=""
NEXT_PUBLIC_WS_URL=""
NEXT_PUBLIC_SUPPORT_SOCKET_URL=""
NEXT_PUBLIC_SUPPORT_SOCKET_PATH="/socket.io"
WS_PORT="3001"
