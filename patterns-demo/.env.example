# ============================================
# SERVER ENVIRONMENT VARIABLES
# These are only available on the server
# ============================================

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/patterns_demo

# JWT Authentication
ACCESS_TOKEN_SECRET=your-access-token-secret-min-32-characters!!
REFRESH_TOKEN_SECRET=your-refresh-token-secret-min-32-characters!!

# API Configuration
API_URL=http://localhost:3000/api

# WebSocket Server
WS_URL=ws://localhost:3001

# Environment
NODE_ENV=development

# Redis (Optional - for distributed rate limiting)
# REDIS_URL=redis://localhost:6379

# SMTP (Optional - for email notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-smtp-password

# Analytics (Optional)
# ANALYTICS_ID=your-analytics-id

# ============================================
# CLIENT ENVIRONMENT VARIABLES
# These are exposed to the browser (NEXT_PUBLIC_ prefix)
# ============================================

NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id
ZAI_API_KEY=your-zai-api-key
