{
  "name": "renkflow-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "RenkFlow monorepo - web platform and mobile app",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "dev:mobile": "cd apps/mobile && npm start",
    "build:web": "cd apps/web && npm run build",
    "vercel-build": "cd apps/web && npm run build",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "test": "npm run test --workspaces",
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && find . -name '.next' -type d -prune -exec rm -rf '{}' +",
    "ai:doctor": "node tools/ai-coordinator/src/cli.ts doctor",
    "ai:start": "node tools/ai-coordinator/src/cli.ts start",
    "ai": "node tools/ai-coordinator/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "next": "^16.3.8",
    "typescript": "^5.0.0"
  }
}
