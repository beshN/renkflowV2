{
  "name": "renkflow-v2",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --filter @renkflow/web dev",
    "build": "pnpm --filter @renkflow/web build",
    "lint": "pnpm --filter @renkflow/web lint",
    "typecheck": "pnpm --filter @renkflow/web typecheck",
    "test": "pnpm --filter @renkflow/web test",
    "test:e2e": "pnpm --filter @renkflow/web test:e2e",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}
