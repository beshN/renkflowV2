  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "Login_auth_login",
        "security": [],
        "parameters": [
          {
            "in": "header",
            "name": "X-RenkFlow-App-Version",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          },
          {
            "in": "header",
            "name": "X-RenkFlow-Platform",
            "required": true,
            "schema": {
              "enum": [
                "android",
                "ios"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Login"
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "426": {
            "description": "Application update required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-response-type": "Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        }
      }
    },
