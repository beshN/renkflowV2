# RenkFlow - Environment Variables

# 🔵 Neon Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?sslmode=require"

# 🟠 Cloudflare R2 (S3 Compatible)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_ACCESS_KEY="your_r2_secret_key"
R2_BUCKET_NAME="renkflow-documents"
R2_PUBLIC_URL="https://documents.yourdomain.com"  # Optional: custom domain

# 🟢 Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"

# 📧 Application Settings (Optional)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 🔴 Redis (Rate Limiting & Sessions)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"
REDIS_KEY_PREFIX="renkflow:"

# 🔒 NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""  # Generate: openssl rand -base64 32

# 📊 Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_APP_VERSION="1.0.0"

# � Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# �📝 Logging & Monitoring
LOG_LEVEL="info"  # debug | info | warn | error
ENABLE_CONSOLE_LOGS="true"
ENABLE_ADMIN_NOTIFICATIONS="false"
ADMIN_NOTIFICATION_EMAIL=""

# ⚠️ SECURITY: These secrets should ONLY be in CI/CD environment variables
# NEVER commit actual values - use GitHub Secrets, Vercel Env, etc.
# INTERNAL_API_SECRET - Set in Vercel/GitHub Secrets only
# VERCEL_TOKEN - Set in GitHub Secrets only
# SNYK_TOKEN - Set in GitHub Secrets only
